[Unit]
Description=Memoria em Duelo web application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/memoria-em-duelo
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DB_PATH=/var/lib/memoria-em-duelo/memoria.db
EnvironmentFile=/etc/memoria-em-duelo.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
