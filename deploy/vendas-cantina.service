[Unit]
Description=CaixaFacil cantina sales application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/vendas-cantina
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DB_PATH=/var/lib/vendas-cantina/vendas.db
EnvironmentFile=/etc/vendas-cantina.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
